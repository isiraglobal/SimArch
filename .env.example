# SimArch Environment Configuration Template
# Copy this file to .env to customize settings.

# Environment: development, staging, production
SIMARCH_ENV=development

# Custom root directory for SQLite database and workspaces (defaults to ~/.simarch or ./.simarch)
SIMARCH_HOME=./.simarch

# Default Model Provider (deterministic-local is 100% offline and requires zero keys)
SIMARCH_DEFAULT_MODEL=deterministic-local

# Dashboard Configuration
SIMARCH_ENABLE_DASHBOARD=true
SIMARCH_DASHBOARD_HOST=127.0.0.1
SIMARCH_DASHBOARD_PORT=8400

# Optional External Model Providers (SimArch auto-falls back to deterministic-local if missing)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
